# Ubuntu based Mambaforge (Minimal Focal)
FROM condaforge/mambaforge:latest
ARG DEBIAN_FRONTEND=noninteractive

# Install all packages via mamba (no apt-get needed)
RUN mamba install -y -c conda-forge -c bioconda \
        unzip \
        vim \
        rsync \
        gzip \
        ca-certificates \
        bcftools \
        bedtools \
        jq \
        bc \
    && mamba clean -afy

COPY ./app /app
COPY ./STARK.docker-compose.yml /app/config/module/

WORKDIR "/app"
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]
CMD ["/bin/bash"]
