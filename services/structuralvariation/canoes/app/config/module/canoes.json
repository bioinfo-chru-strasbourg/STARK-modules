{
    "services": {
        "CANOES": {
            "infos": {
                "name": "CANOES",
                "description": "CANOES analysis",
                "triggers-description": "(STARKCopyComplete.txt AND NOT (CANOESRunning.txt AND CANOESComplete.txt AND CANOESFailed.txt) AND (#CANOES OR GROUP DIAG) AND (NOT #POOL OR (#POOL AND (POOLRunning.txt OR POOLComplete.txt))))"
            },
            "triggers": {
                "OR_1": {
                    "AND_1": {
                        "file": [
                            "STARKCopyComplete.txt",
                            "!CANOESRunning.txt",
                            "!CANOESComplete.txt",
                            "!CANOESFailed.txt"
                        ],
                        "tags": [
                            "!POOL"
                        ],
                        "OR_2": {
                            "tags": [
                                "CANOES"
                            ],
                            "group": [
                                "DIAG",
                                "HUSDIAGGEN"
                            ]
                        }
                    },
                    "AND_2": {
                        "file": [
                            "STARKCopyComplete.txt",
                            "!CANOESRunning.txt",
                            "!CANOESComplete.txt",
                            "!CANOESFailed.txt",
                            "!POOLRunning.txt",
                            "POOLComplete.txt"
                        ],
                        "tags": [
                            "POOL"
                        ],
                        "OR_3": {
                            "tags": [
                                "CANOES"
                            ],
                            "group": [
                                "DIAG",
                                "HUSDIAGGEN"
                            ]
                        }
                    }
                }
            }
        }
    }
}
