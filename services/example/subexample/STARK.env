######################################
# Docker service STARK configuration #
######################################

DOCKER_STARK_MODULE_NAME=example
DOCKER_STARK_MODULE_SUBMODULE_NAME=subexample

SUBMODULE_VERSION=1.0.0
LISTENER_VERSION=2.0

GENOME=hg19

SUBMODULE_API_EXTERNAL_PORT=9999
SUBMODULE_API_KEY=key

# You do not have to change anything below this line
# Everything is filled with the variables above

# SERVICE cli
####################

# VOLUMES
SUBMODULE_HOST_CONFIG=${DOCKER_STARK_MAIN_FOLDER}/${DOCKER_STARK_FOLDER_CONFIG}/${DOCKER_STARK_MODULE_NAME}/${DOCKER_STARK_MODULE_SUBMODULE_NAME}/cli
SUBMODULE_HOST_SERVICES=${DOCKER_STARK_MAIN_FOLDER}/${DOCKER_STARK_FOLDER_SERVICES}/${DOCKER_STARK_MODULE_NAME}/${DOCKER_STARK_MODULE_SUBMODULE_NAME}/cli

# SERVICE listener
####################

# VOLUMES
LISTENER_HOST_CONFIG=${DOCKER_STARK_MAIN_FOLDER}/${DOCKER_STARK_FOLDER_CONFIG}/${DOCKER_STARK_MODULE_NAME}/${DOCKER_STARK_MODULE_SUBMODULE_NAME}/listener
LISTENER_HOST_SERVICES=${DOCKER_STARK_MAIN_FOLDER}/${DOCKER_STARK_FOLDER_SERVICES}/${DOCKER_STARK_MODULE_NAME}/${DOCKER_STARK_MODULE_SUBMODULE_NAME}/listener
